/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'QUPATH_STITCH' {
        beforeScript = "export PATH=\$PATH:${projectDir}/bin/QuPath/bin"
    }

    // One pass: marker channel selection, downscaling and nuclear / membrane / AF channel extraction
    withName: 'PREPROCESS_IMAGE' {
        ext.args = { [
            params.downscale_mode == '1um' ? '--target_mpp 1' : '',
            "--nuclear '${params.nuclear_channel}'",
            params.membrane_channel ? "--membrane '${params.membrane_channel}'" : '',
            params.dapi_bg_method == 'af' ? "--af '${params.af_channel}'" : ''
        ].join(' ').trim() }
    }

    withName: 'PREPARE_ROI' {
        ext.args = { [
            "--exclude '${params.roi_exclude_classes}'",
            params.roi_flip_y ? '--flip_y' : ''
        ].join(' ').trim() }
    }

    withName: 'MAKE_PATCHES' {
        ext.args = { [
            "--patch_size ${params.patch_size} --patch_overlap ${params.patch_overlap}",
            params.segmentation == 'cellpose' ? '--stack_membrane' : ''
        ].join(' ').trim() }
    }

    // Segmentation runs once per patch; patch masks are named by patch so they can be resolved together
    withName: "DEEPCELL_MESMER" {
        ext.prefix = { "${meta.base_id}_patch${meta.patch}_mesmer" }
        ext.args = "--compartment 'nuclear' --image-mpp '1'"
    }

    // Model and diameter are set via --cellpose_model / --cellpose_diam
    withName: "CELLPOSE" {
        ext.prefix = { "${meta.base_id}_patch${meta.patch}_cellpose" }
        ext.args = "--verbose"
    }

    withName: 'RESOLVE_PATCHES' {
        ext.prefix = { "${meta.base_id}_${meta.seg}" }
        ext.args = { "--threshold ${params.patch_merge_threshold}" }
    }

    withName: 'ANNOTATE_CELLS' {
        ext.prefix = { "${meta.base_id}_${meta.seg}" }
    }

    withName: 'MCQUANT' {
        ext.prefix = { "${meta.base_id}_${meta.seg}" }
    }
}
