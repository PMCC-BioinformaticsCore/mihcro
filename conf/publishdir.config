        ]
    }

    withName: "MCQUANT" {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation/${meta.seg}_mcquant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'RENDER_SEGMENTATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation/overviews" },
