/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'QUPATH_STITCH' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/image_hires" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'INDICA_TIFF_TO_OME' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/image_hires" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Processed image, its OME-XML / scale metadata, and the extracted single channels
    withName: 'PREPROCESS_IMAGE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.endsWith('.downscaled.ome.tiff')) return "image_downscale/${filename}"
                if (filename.endsWith('.processed.ome.tiff'))  return "image_processed/${filename}"
                if (filename.endsWith('.xml') || filename.endsWith('.json')) return "metadata/${filename}"
                if (filename.endsWith('.tif')) return "extracted_channels/${filename}"
                return null
            }
        ]
    }

    withName: 'DAPI_BACKGROUND_REMOVAL' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/dapi_processed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PREPARE_ROI|TISSUE_DETECT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/roi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-patch images and masks are intermediate; only the patch table and overview are published
    withName: 'MAKE_PATCHES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/patches" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_patches.csv') || filename.endsWith('_patches.png') ? filename : null }
        ]
    }

    // Whole-image segmentation mask, resolved from the per-patch DEEPCELL_MESMER / CELLPOSE masks
    withName: 'RESOLVE_PATCHES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANNOTATE_CELLS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation/${meta.seg}_mcquant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_cells_roi.csv') ? filename : null }
        ]
    }

    withName: "MCQUANT" {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation/${meta.seg}_mcquant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RENDER_SEGMENTATION' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/segmentation/overviews" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // QC report, Seurat object and per-cluster marker intensities
    withName: 'RENDER_REPORT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.endsWith('_report.html')) return "reports/${filename}"
                if (filename.endsWith('_seurat.rds')) return "seurat_objects/${filename}"
                if (filename.endsWith('_cluster_mean_intensity.csv')) return "cluster_markers/${filename}"
                return null
            }
        ]
    }
}
